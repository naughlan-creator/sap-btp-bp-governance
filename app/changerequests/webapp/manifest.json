{
  "_version": "1.65.0",
  "sap.app": {
    "id": "bpgov.changerequests",
    "type": "application",
    "title": "BP Change Requests",
    "description": "Govern Business Partner master data changes",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/governance/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ChangeRequestsList",
          "target": "ChangeRequestsList"
        },
        {
          "pattern": "ChangeRequests({key}):?query:",
          "name": "ChangeRequestsObjectPage",
          "target": "ChangeRequestsObjectPage"
        }
      ],
      "targets": {
        "ChangeRequestsList": {
          "type": "Component",
          "id": "ChangeRequestsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ChangeRequests",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "ChangeRequests": { "detail": { "route": "ChangeRequestsObjectPage" } }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": { "type": "ResponsiveTable", "selectionMode": "Single" }
                }
              }
            }
          }
        },
        "ChangeRequestsObjectPage": {
          "type": "Component",
          "id": "ChangeRequestsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/ChangeRequests",
              "editableHeaderContent": false
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
